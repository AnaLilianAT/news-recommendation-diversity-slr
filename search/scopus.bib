@ARTICLE{Chakraborty2019447,
	author = {Chakraborty, Abhijnan and Ghosh, Saptarshi and Ganguly, Niloy and Gummadi, Krishna P.},
	title = {Optimizing the recency-relevance-diversity trade-offs in non-personalized news recommendations},
	year = {2019},
	journal = {Information Retrieval Journal},
	volume = {22},
	number = {5},
	pages = {447 - 475},
	doi = {10.1007/s10791-019-09351-2},
	url = {https://www.scopus.com/pages/publications/85062607506?origin=resultslist},
	abstract = {Online news media sites are emerging as the primary source of news for a large number of users. Due to a large number of stories being published in these media sites, users usually rely on news recommendation systems to find important news. In this work, we focus on automatically recommending news stories to all users of such media websites, where the selection is not influenced by a particular user’s news reading habit. When recommending news stories in such non-personalized manner, there are three basic metrics of interest—recency, importance (analogous to relevance in personalized recommendation) and diversity of the recommended news. Ideally, recommender systems should recommend the most important stories soon after they are published. However, the importance of a story only becomes evident as the story ages, thereby creating a tension between recency and importance. A systematic analysis of popular recommendation strategies in use today reveals that they lead to poor trade-offs between recency and importance in practice. So, in this paper, we propose a new recommendation strategy (called Highest Future-Impact) which attempts to optimize on both the axes. To implement our proposed strategy in practice, we propose two approaches to predict the future-impact of news stories, by using crowd-sourced popularity signals and by observing editorial selection in past news data. Finally, we propose approaches to inculcate diversity in recommended news which can maintain a balanced proportion of news from different news sections. Evaluations over real-world news datasets show that our implementations achieve good performance in recommending news stories. © 2019, The Author(s).},
	author_keywords = {Coverage bias; News recommendation; Recency-relevance trade-off; Recommendation diversity},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 21; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Tang2025,
	author = {Tang, Xu},
	title = {Personalized News Recommendation System Using Hybrid Collaborative Filtering and Latent Factor Modeling},
	year = {2025},
	journal = {International Conference on Software, Systems and Information Technology, SSITCON 2025},
	pages = {},
	doi = {10.1109/SSITCON66133.2025.11342199},
	url = {https://www.scopus.com/pages/publications/105033146563?origin=resultslist},
	abstract = {Nowadays, the personalized news recommendation has become crucial in managing the overwhelming volume of online content for ensuring that the users receive relevant and engaging information. However, the existing models faced challenges which led to limit scalability, inability to capture temporal dynamics and poor recommendation diversity. Hence, this research proposes a Hybrid Collaborative Filtering and Latent Factor Modeling (HCF-LFM) model to provide accurate, scalable and interpretable personalized news recommendations. Initially, the input data is collected from Microsoft New Dataset (MIND) which contains over 1M users, 160k new articles and 24M user interactions for providing a robust basis for modeling user preferences and article relevance. Then, the collected data is preprocessed to construct a user-item interaction matrix, handle sparsity, and encode article metadata. After that, the features are extracted through user and item similarity computations, latent factor decomposition and article embeddings by capturing the semantic content. Finally, the recommendation system combines collaborative filtering techniques and matrix factorization predictions to generate tope-K personalized news for each user. From the results, the proposed HCF-LFM demonstrated improved precision, recall and ranking metrics than the existing models. © 2025 IEEE.},
	author_keywords = {collaborative filtering; content-enhanced embeddings; latent factor modeling; matrix factorization; personalized news recommendation system},
	keywords = {Embeddings; Matrix algebra; Recommender systems; Semantics; Content-enhanced embedding; Embeddings; Latent factor models; Matrix factorizations; News recommendation; Online content; Personalized news; Personalized news recommendation system; Recommendation diversities; Temporal dynamics; Collaborative filtering; Factorization},
	type = {Conference paper},
