@ARTICLE{Voinea2025,
	author = {Voinea, Dan Valeriu},
	title = {Reconceptualizing Gatekeeping in the Age of Artificial Intelligence: A Theoretical Exploration of Artificial Intelligence-Driven News Curation and Automated Journalism},
