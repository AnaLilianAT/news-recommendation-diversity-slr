@ARTICLE{Hasan2026,
	author = {Hasan, Mahamudul and Paul, Ranjan and Pola, Aditya Vardhan},
	title = {Fuzzy Lorenz indices of informational inequality for news recommendation systems: An axiomatic framework with temporal decay},
	year = {2026},
	journal = {Fuzzy Sets and Systems},
