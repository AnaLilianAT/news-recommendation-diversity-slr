@ARTICLE{Mohialdeen2025212,
	author = {Mohialdeen, Przha Barzan and Ahmed, Sarkar Hasan},
	title = {A Multilingual Hybrid News Recommendation Framework for Educational Web Portals},
	year = {2025},
	journal = {Kurdistan Journal of Applied Research},
	volume = {10},
