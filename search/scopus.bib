@BOOK{Nishant2026363,
	author = {Nishant, Alvin and Mangai, J. Alamelu and Khanum, Mohammadi Akheela and Meenu, B.},
	title = {Evaluating Recommendation Algorithms: A Case Study on Online News Platforms},
	year = {2026},
	journal = {Next-Generation Recommendation Systems: A Comprehensive Guide to Enabling Technologies and Tools and their Business Benefits},
	pages = {363 - 383},
	doi = {10.1002/9781394351572.ch15},
	url = {https://www.scopus.com/pages/publications/105038526721?origin=resultslist},
	abstract = {In the age of digital information overload, navigating the vast expanse of online content presents significant challenges for users seeking reliable and personalized news sources. To tackle this issue, news recommendation systems have become prominent, utilizing algorithms to deliver customized news articles based on individual interests. This study conducts a thorough examination of existing literature on news recommendation systems, focusing on methodologies, algorithms, empirical findings, challenges, and ethical considerations. By rigorously evaluating and comparing popularity-based, content-based, and collaborative filtering algorithms, this research aims to measure their effectiveness in recommending news articles to users. A performance analysis of the traditional models was done using the MIND dataset. The findings reveal that popularity-based filtering achieves the highest Click-through Rate (CTR) at 0.972, highlighting its success in leveraging collective user preferences. In contrast, content-based filtering exhibits limitations in capturing diverse user interests solely through article content attributes, resulting in a lower CTR of 0.682. Item-based collaborative filtering achieves a commendable CTR of 0.960, showcasing its ability to recommend articles based on item-item relationships. Notably, user-based collaborative filtering emerges as the most effective, with the highest CTR of 0.979, emphasizing the importance of personalized recommendations tailored to individual user preferences in enhancing user engagement. These results underscore the significance of employing diverse recommendation algorithms to address varied user needs and preferences in the domain of news consumption. © 2026 by John Wiley & Sons Inc. All rights reserved.},
	author_keywords = {Algorithm evaluation; Click-through rate (CTR); News recommendation systems; Personalized news; User engagement},
