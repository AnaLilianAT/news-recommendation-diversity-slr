@CONFERENCE{Saxena202347,
	author = {Saxena, Ankur},
	title = {A Survey of Session-Based Recommender Systems},
	year = {2023},
	journal = {Proceedings - IEEE 2023 5th International Conference on Advances in Computing, Communication Control and Networking, ICAC3N 2023},
	pages = {47 - 50},
