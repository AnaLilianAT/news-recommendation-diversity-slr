@inproceedings{10.1145/3774935.3806175,
author = {Wessel, Tobias Jovall and Trattner, Christoph and Starke, Alain},
title = {Increasing Editor Trust in News Personalization Systems with Fact-checked Large Language Models},
year = {2026},
isbn = {9798400723117},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3774935.3806175},
doi = {10.1145/3774935.3806175},
abstract = {Generative AI and Large Language Models (LLMs) offer new opportunities to adapt news content to diverse audiences. However, the use of LLMs raises concerns in journalism practice around factual accuracy, transparency, and editorial accountability. We examine a human-in-the-loop approach to responsible news personalization through an editor-facing system that generates stylistic re-framed summaries of news articles designed to better engage specific target audiences, along with the integration of a factual accuracy dashboard as a safeguard against LLM hallucinations. In an online experiment (N = 270), participants acted as editors by interacting with the system, choosing between three LLM-generated news article summaries (in the styles ‘neutral’, ‘moral’ or ‘satirical’) to fit eight empirically grounded audience personas. Results showed systematic alignment between summary selections and persona characteristics, while the presence of a factual accuracy dashboard increased system trust, which was positively moderated by age. We find that transparency in generative AI systems can increase trust in AI-assisted editorial tools.},
booktitle = {Proceedings of the 34th ACM Conference on User Modeling, Adaptation and Personalization},
pages = {89–97},
numpages = {9},
keywords = {Large Language Models, Journalism, Personalization, Explainable AI (XAI), Automated Fact-Checking, Trust, News Avoidance},
location = {
},
series = {UMAP '26}
}

@inproceedings{10.1145/3709026.3709066,
author = {Long, Haixiang and Luo, Xudong},
title = {MUNE: A Multi-Level User-News Embedding Model for Personalised News Recommendations},
year = {2025},
isbn = {9798400718182},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3709026.3709066},
doi = {10.1145/3709026.3709066},
abstract = {Personalised news recommendation systems are critical for delivering relevant content, but effectively capturing and modelling users’ diverse and evolving interests is challenging. In this paper, we introduce a Multi-level User-News Embedding (MUNE) model for personalised news recommendations. MUNE uses pre-trained BERT embeddings to generate contextual representations, enabling dynamic, multi-level interaction modelling between users and candidate news. It incorporates a Dynamic Multi-Level Interaction Attention (DMIA) module for capturing complex interactions and a Dynamic Similarity Unit (DSU) for enhancing feature fusion using cosine similarity and non-linear transformations. Evaluated on large-scale datasets (MIND and EB-NeRD), MUNE significantly outperforms state-of-the-art baselines in key metrics, with ablation studies validating the importance of DMIA and DSU in improving user interest modelling and recommendation quality. MUNE’s integration of multi-level features makes it highly effective in capturing user behaviours and understanding news content.},
booktitle = {Proceedings of the 2024 8th International Conference on Computer Science and Artificial Intelligence},
pages = {374–381},
numpages = {8},
keywords = {personalised news recommendation, pre-trained language model, BERT, attention, classification problem},
location = {
},
series = {CSAI '24}
}

@inproceedings{10.1145/3604915.3608801,
author = {Yang, Boming and Liu, Dairui and Suzumura, Toyotaro and Dong, Ruihai and Li, Irene},
title = {✨ Going Beyond Local: Global Graph-Enhanced Personalized News Recommendations},
year = {2023},
isbn = {9798400702419},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3604915.3608801},
doi = {10.1145/3604915.3608801},
abstract = {Precisely recommending candidate news articles to users has always been a core challenge for personalized news recommendation systems. Most recent works primarily focus on using advanced natural language processing techniques to extract semantic information from rich textual data, employing content-based methods derived from local historical news. However, this approach lacks a global perspective, failing to account for users’ hidden motivations and behaviors beyond semantic information. To address this challenge, we propose a novel model called GLORY (Global-LOcal news Recommendation sYstem), which combines global representations learned from other users with local representations to enhance personalized recommendation systems. We accomplish this by constructing a Global-aware Historical News Encoder, which includes a global news graph and employs gated graph neural networks to enrich news representations, thereby fusing historical news representations by a historical news aggregator. Similarly, we extend this approach to a Global Candidate News Encoder, utilizing a global entity graph and a candidate news aggregator to enhance candidate news representation. Evaluation results on two public news datasets demonstrate that our method outperforms existing approaches. Furthermore, our model offers more diverse recommendations1.},
booktitle = {Proceedings of the 17th ACM Conference on Recommender Systems},
pages = {24–34},
numpages = {11},
keywords = {Graph Neural Network, News Modeling, News Recommendation},
location = {Singapore, Singapore},
series = {RecSys '23}
}

