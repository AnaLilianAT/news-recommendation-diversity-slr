@INPROCEEDINGS{4797232,
  author={Chen, Wei and Zhang, Li-jun and Chen, Chun and Bu, Jia-jun},
  booktitle={2009 WRI International Conference on Communications and Mobile Computing}, 
  title={A hybrid phonic web news recommender system for pervasive access}, 
  year={2009},
  volume={3},
  number={},
  pages={122-126},
  abstract={With the development of the Mobile Internet, it is possible for people to access their daily portion of news over the Web with various types of terminals connected to it. EagleRadio is a phonic Web news recommendation system which helps users access personalized news via mobile Internet. It reads news via a speech synthesizer to users. We propose a hybrid news recommending strategy considering not only the user's listening history, but also taking the user's neighbors with similar tastes and preferences into account. It can track multiple threads of user's interests and the diversity of recommended news list is also guaranteed. Finally, we evaluate the proposed algorithms and quantify the effect of them from a user's perspective.},
  keywords={Recommender systems;Internet;Speech synthesis;Mobile communication;Collaborative work;Synthesizers;Collaboration;Prototypes;Handheld computers},
  doi={10.1109/CMC.2009.20},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{6779166,
  author={Oh, Kyo-Joong and Lee, Won-Jo and Lim, Chae-Gyun and Choi, Ho-Jin},
  booktitle={16th International Conference on Advanced Communication Technology}, 
  title={Personalized news recommendation using classified keywords to capture user preference}, 
  year={2014},
  volume={},
  number={},
  pages={1283-1287},
  abstract={Recommender systems are becoming an essential part of smart services. When building a news recommender system, we should consider special features different from other recommender systems. Hot news topics are changing every moment, thus it is important to recommend right news at the right time. This paper aims to propose a new model, based on deep neural network, to analyse user preference for news recommender system. The model extracts interest keywords to characterize the user preference from the set of news articles read by that particular user in the past. The model utilizes characterizing features for news recommendation, and applies those to the keyword classification for user preference. For the keyword classification, we use deep neural network for online preference analysis, because adaptive learning is necessary to track changes of hot topics sensitively. The usefulness of our model is validated through experiments. In addition, the accuracy and diversity of the recommendation results is also analysed.},
  keywords={Adaptation models;Neural networks;Educational institutions;Recommender systems;Computer science;Accuracy;Google;Preference mining;keyword classification;deep belief network;user profile;news recommendation},
  doi={10.1109/ICACT.2014.6779166},
  ISSN={1738-9445},
  month={Feb},}@INPROCEEDINGS{7058064,
  author={Desarkar, Maunendra Sankar and Shinde, Neha},
  booktitle={2014 International Conference on Data Science and Advanced Analytics (DSAA)}, 
  title={Diversification in news recommendation for privacy concerned users}, 
  year={2014},
  volume={},
  number={},
  pages={135-141},
  abstract={With more and more news sources publishing news articles online, news recommendation systems are becoming increasingly popular in recent days. However, if a news recommender shows to the user many news articles that cover same story or talk about same persons or events, then the recommendations might become monotonous for the user. A possible way to handle this scenario is to diversify the recommended news articles so that the articles in the recommendation list are not too similar to each other. Existing research works in literature discuss how to use user-specific relevance of news articles and diversification to produce the final recommendations. To be able to compute user-specific relevance of articles, several recommender systems suggest that users have a login, or they set cookies to track page visits of the users. Often users are unsure whether the information collected via these means will be used for the sole purpose of news recommendation. Privacy of the identity and page access patterns is a concern for many users. In this work, we consider the problem where diverse recommendations are to be given for users, but no past data about users is collected or stored by the system. We use only article popularity to estimate the relevance. We identify few aspects of news articles on which diversification can be performed. These aspects are incorporated in an optimization framework. An approximation algorithm is used to generate the recommendations. Experimental analysis shows that in scenarios where no individual user data is stored or accessible by the recommender system, diversification results in higher click rates and increase in the number of satisfied users. Performances of the multiple diversification aspects and approaches are also analyzed.},
  keywords={Measurement;Recommender systems;History;Approximation methods;Collaboration;Computational modeling;Equations},
  doi={10.1109/DSAA.2014.7058064},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{7425943,
  author={Wu Yang and Rui Tang and Ling Lu},
  booktitle={2016 International Conference on Big Data and Smart Computing (BigComp)}, 
  title={A fused method for news recommendation}, 
  year={2016},
  volume={},
  number={},
  pages={341-344},
  abstract={In news recommendation system, the content-based method face the lack of diversity that recommended results will only contain the news similar with user's former read. The hybrid method face cold-start problem that the candidate news must wait enough click to recommend. We propose a fused method which is capable of handling the diversity problem of content-based and cold-start problem of hybrid approach. We use content-based method to extract user's existed interest firstly. Find out similar user set and predict target user's potential interest by collaborative filtering secondly. Fuse existed interest and potential interest to obtain the final user profile the third. Generate the recommended results after comparison the similarity of candidate news and final user profile lastly. This approach results in an offline news set and compared Diversity and F-score with other recommendation method. It decreases the lack of diversity compare with content-based approach and avoids the cold-start problem compare with hybrid method.},
  keywords={Filtering;Collaboration;Fuses;Time factors;Constitution;Diversity methods;Computer science;news recommendation;content-based;collaborative filtering;user profile;hybrid recommendation},
  doi={10.1109/BIGCOMP.2016.7425943},
  ISSN={2375-9356},
  month={Jan},}@ARTICLE{8470074,
  author={Yu, Qilian and Xu, Li and Cui, Shuguang},
  journal={IEEE Access}, 
  title={Streaming Algorithms for News and Scientific Literature Recommendation: Monotone Submodular Maximization With a  $d$ -Knapsack Constraint}, 
  year={2018},
  volume={6},
  number={},
  pages={53736-53747},
  abstract={Submodular optimization plays a significant role in combinatorial problems, since it captures the structure of the edge cuts in graphs, the coverage of sets, and so on. Many data mining and machine learning problems can be cast as submodular maximization problems with applications in recommendation systems and data diversification. In this paper, we focus on the problem of maximizing a monotone submodular function subject to a d-knapsack constraint, for which we propose a streaming algorithm that achieves a ((1/1 + 2d) - e)-approximation of the optimal value, while it only needs one single pass through the data set without storing all the data in the memory. In our experiments, we extensively evaluate the effectiveness of our proposed algorithm via two applications: news recommendation and scientific literature recommendation. It is observed that the proposed streaming algorithm achieves both execution speedup and memory saving by several orders of magnitude, compared with existing approaches.},
  keywords={Approximation algorithms;Greedy algorithms;Optimized production technology;Machine learning algorithms;Memory management;Machine learning;Submodular optimization;streaming algorithm;news recommendation;scientific literature recommendation},
  doi={10.1109/ACCESS.2018.2871668},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{8609579,
  author={Gao, Jie and Xin, Xin and Liu, Junshuai and Wang, Rui and Lu, Jing and Li, Biao and Fan, Xin and Guo, Ping},
  booktitle={2018 IEEE/WIC/ACM International Conference on Web Intelligence (WI)}, 
  title={Fine-Grained Deep Knowledge-Aware Network for News Recommendation with Self-Attention}, 
  year={2018},
  volume={},
  number={},
  pages={81-88},
  abstract={On-line news reading has become the most popular way for user to obtain real-time information. With the millions of news, it is a key challenge to help user find the articles that are interesting to read. Although great achievements have been made, there is little work to focus on combing news language with external knowledge graphs and expanding news text from a word-level. Taking this issue into consideration, we introduce a novel self-attention based mechanism in news recommendation. The key component of our model is multiple self-attention modules: the word-level attention, which takes tags of news, entities in external knowledge graph and entities' contexts as the input to calculate the semantic-level and knowledge-level representation of the news; the item-level attention module, which used to fuse the two-level representation into the same low-dimension and get a overall embedding of user history behavior sequence. Specially, in order to deal with the diversity of user preferences, we use another self-attention module dynamically aggregate user click history and select candidate news. And finally, a multi-head attention module is used to connect history and candidate news and then calculate the click-through-rate(CTR) via a fully connected layer. Through amount of experiments on a real-world online news website, we demonstrate that our model outperforms better results than previous start-of-art recommendation models.},
  keywords={Knowledge engineering;History;Deep learning;Task analysis;Computational modeling;Fuses;Semantics;News recommendation;knowledge graph embedding;self-attention model;deep neural network},
  doi={10.1109/WI.2018.0-104},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{8663807,
  author={Yajun, Ma and Sheng, Lin},
  booktitle={2018 IEEE 9th International Conference on Software Engineering and Service Science (ICSESS)}, 
  title={Application of LDA-LR in Personalized News Recommendation System}, 
  year={2018},
  volume={},
  number={},
  pages={279-282},
  abstract={With the arrival of the big data age, and users can't effectively find information that matches their interest in the vast quantities of data. The common personalized news recommendation system is based on the user - based collaborative filtering algorithm. However, the content coverage recommended by this keyword based recommendation is narrow and cannot meet users' requirements for the diversity of recommendation systems. For textual data like news, it contains semantic attributes. Therefore, this paper proposes a LDA-LR personalized news recommendation method, which uses the LDA theme model to train the theme distribution of each news, then calculates the user similarity based on the topic, and then combines the LR logistic regression model to filter, and obtains the final news recommendation list.},
  keywords={Collaboration;Filtering algorithms;Semantics;Logistics;Computational modeling;Mathematical model;Data mining;topic model;logistic regression;personalized news recommendation},
  doi={10.1109/ICSESS.2018.8663807},
  ISSN={2327-0594},
  month={Nov},}@INPROCEEDINGS{8808047,
  author={Sertkan, Mete and Neidhardt, Julia and Werthner, Hannes},
  booktitle={2019 IEEE 21st Conference on Business Informatics (CBI)}, 
  title={Documents, Topics, and Authors: Text Mining of Online News}, 
  year={2019},
  volume={01},
  number={},
  pages={405-413},
  abstract={The goal of recommender systems is, in essence, to help people to discover items they might like, i.e., items that fit their preferences, personality, and needs. Depending on the respective domain, those items can be books, movies, music, hotels, and much more. Typically, recommendations are based on past user interactions (e.g., movies a user saw, hotels a user booked, etc.). This work in progress paper focuses on news recommender systems. Because of the nature of news (e.g., constantly new items, short item lifetime, etc.), recommendations based on past interactions are especially hard to make. Hence, news recommender systems heavily rely on the actual content of news. While previous work mainly considers one aspect of the content of news articles, we jointly analyse and discuss in this work a given corpora of news articles on three different levels (i.e., document-level, topic-level, and author-level). The overall aim is to set to provide the basis for a comprehensive news recommender system, which reaches beyond accuracy and considers also diversity and serendipity. We demonstrate that relevant information can be extracted out of a given corpora, and differences in author, time, and topic can be shown. Furthermore, the author-level analysis shows that documents can be clustered based on the writing style of authors. Finally, our findings show that author-level analysis has the potential to recommend the most diverse items compared to the other approaches.},
  keywords={Task analysis;Text mining;Recommender systems;Standards;Motion pictures;Recommender Systems;Online News;Text Mining;Topic Modelling;Co-occurence Networks},
  doi={10.1109/CBI.2019.00053},
  ISSN={2378-1971},
  month={July},}@ARTICLE{9026823,
  author={Darvishy, Asghar and Ibrahim, Hamidah and Sidi, Fatimah and Mustapha, Aida},
  journal={IEEE Access}, 
  title={HYPNER: A Hybrid Approach for Personalized News Recommendation}, 
  year={2020},
  volume={8},
  number={},
  pages={46877-46894},
  abstract={A personalised news recommendation system extracts news set from multiple press releases and presents the recommended news to the user. In an effort to build a better recommender system with high accuracy, this paper proposes a personalised news recommendation framework named Hybrid Personalised NEws Recommendation (HYPNER). HYPNER combines both collaborative filtering-based and content-based filtering methods. The proposed framework aims at improving the accuracy of news recommendation by resolving the issues of scalability due to large news corpus, enriching the user's profile, representing the exact properties and characteristics of news items, and recommending diverse set of news items. Validation experiments showed that HYPNER achieved 81.56% improvement in F1 -score and 5.33% in diversity as compared to an existing recommender system, SCENE.},
  keywords={Clustering algorithms;Metadata;Collaboration;Scalability;Recommender systems;Google;Collaborative filtering;content-based filtering;news recommendation;personalised news recommendation},
  doi={10.1109/ACCESS.2020.2978505},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{9142663,
  author={Chłodziński, Grzegorz and Woźniak, Karol},
  booktitle={2020 13th International Conference on Human System Interaction (HSI)}, 
  title={Deep learning for recommending subscription-limited documents}, 
  year={2020},
  volume={},
  number={},
  pages={29-33},
  abstract={Documents recommendation for a commercial, subscription-based online platform is important due to the difficulty in navigation through a large volume and diversity of content available to clients. However, this is also a challenging task due to the number of new documents added every day and decreasing relevance of older contents. To solve this problem, we propose deep neural network architecture that combines autoencoder with multilayer perceptron in a hybrid recommender system. We train our model using real-world historical data from commercial platform using interactions to capture user similarity and categorical document features to predict the probability of a user-document interaction. Our experimental results demonstrate the effectiveness of the proposed architecture. We plan to release our model in a commercial online platform to support a personalized user experience.},
  keywords={Neural networks;Recommender systems;Training;Machine learning;Task analysis;Collaboration;Recommender Systems;News Recommendation;Deep Learning;Autoencoders},
  doi={10.1109/HSI49210.2020.9142663},
  ISSN={2158-2254},
  month={June},}@INPROCEEDINGS{9325799,
  author={Li, Lin and Wang, Li},
  booktitle={2020 13th International Symposium on Computational Intelligence and Design (ISCID)}, 
  title={News Recommendation Based on Content Fusion of User Behavior}, 
  year={2020},
  volume={},
  number={},
  pages={217-220},
  abstract={To address the problem that content-based recommendation algorithm lacks diversified user interests, a news recommendation algorithm based on content fusion user behavior is proposed. Firstly, the content-based algorithm is used to improve the computation of user interest weights by considering the effect of time on user interest and to discover users' own preferences. Secondly, considering the time utility and the correlation between the popularity of the news and users' interests, finding users' nearest neighbors using content- based and improved behavior-based mixed similarity to discover their potential preferences. Finally, the user's own preferences are fused with potential preferences to generate a recommended list. The experimental result shows that compared to the traditional recommendation algorithm, the improved algorithm has a maximum increase of 9. 80% in recommendation accuracy, a maximum increase of 10. 12% in recall, and a maximum increase of 6. 23% in diversity. The experimental result shows that the improved recommendation algorithm effectively improves the quality of recommendation, enrichs diversity, and has good recommendation effect.},
  keywords={Collaborative filtering;Heuristic algorithms;Software algorithms;Time factors;Systems architecture;Recommender systems;Training;Content-based recommendation;Collaborative filtering;News recommendation},
  doi={10.1109/ISCID51228.2020.00055},
  ISSN={2473-3547},
  month={Dec},}@INPROCEEDINGS{9378340,
  author={Raza, Shaina and Ding, Chen},
  booktitle={2020 IEEE International Conference on Big Data (Big Data)}, 
  title={A Regularized Model to Trade-off between Accuracy and Diversity in a News Recommender System}, 
  year={2020},
  volume={},
  number={},
  pages={551-560},
  abstract={News recommender systems are usually designed to provide accurate and personalized recommendations to the readers. The diversity of the recommended results has received much less attention in this field. When it is considered, the current state-of-the-art models often apply the re-ranking mechanisms to promote the diversified results to the individual users. In this work, we propose a latent factor model to achieve the requisite level of accuracy while maintaining a reasonable level of diversity in a news recommender system. The existing latent factor methods mostly rely on Tikhonov regularization to improve the generality of the learnt models. These methods tend to focus mainly on accuracy measures, i.e., generating recommendations highly aligned with a user's past preference, which may cause a decrease in the diversity of information to which news readers are exposed. In our work, we make effective use of elastic-net regression to regularize the model for both the accuracy and the diversity in a single optimization framework. We demonstrate the effectiveness of our model over the state-of-the-art methods by conducting extensive experiments on a real-world news dataset.},
  keywords={Measurement;Conferences;Neural networks;Big Data;Prediction algorithms;Recommender systems;Optimization;Regularization;Accuracy;Diversity;News Recommender;Optimization;Latent factors;User-item Interactions},
  doi={10.1109/BigData50022.2020.9378340},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9457817,
  author={Zhao, Yunwei and Wang, Can and Han, Han and Shu, Min and Wang, Wenlei},
  booktitle={2020 IEEE/WIC/ACM International Joint Conference on Web Intelligence and Intelligent Agent Technology (WI-IAT)}, 
  title={An Impact Evaluation Framework of Personalized News Aggregation and Recommendation Systems}, 
  year={2020},
  volume={},
  number={},
  pages={893-900},
  abstract={There are mounting concerns that personalized recommenders contribute to population differentiation and polarization by creating “information cocoons” that insulate people from opposing views. Despite the vast amount of research devoting to design new algorithms to improve the performance of recommendation systems, the evaluation mostly focuses on recommendation quality. Little attention is paid to the social impact of recommendation systems. On the other hand, it is noted in the literature that the users of recommendation systems suffer from “partial information blindness”, i.e. only exposed to the like-minded content information cocoon or filter bubble. Therefore, in this paper, we propose an impact evaluation framework of recommendation systems, comprising of five constructs, namely, diversity, objectivity, information cocoon, affect cocoon, and intentionality. The evaluation is conducted in a “black-box” way based on the empirical interaction data between the recommender and its individual users. To enable the individual level evaluation, we propose a lightweight agent-based simulation to collect individual’s interaction data with recommenders in the complex real-world scenarios. Furthermore, we illustrate the effectiveness of the proposed methodology with a case study in Toutiao and Baidu News, which are the top two news aggregator apps in China. The results show that both applications demonstrate a periodic information cocoon of about 7-day time interval, the news recommended through these two apps bear distinct differences: Toutiao has better captured the user’s reading preference and the quality of the recommended articles, while Baidu News demonstrate a higher affect cocoon and intentionality in the recommended articles, with average perceived difficulty of the recommended articles 2.9% higher than Toutiao, and average perceived persuasiveness 9.6% higher than Toutiao.},
  keywords={Web and internet services;Sociology;Information filters;Data models;Intelligent agents;Statistics;evaluation framework;personalized recommendation;social impact},
  doi={10.1109/WIIAT50758.2020.00136},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9469577,
  author={KE, HAOWEN},
  booktitle={2020 International Conference on Machine Learning and Cybernetics (ICMLC)}, 
  title={Improving Self-Attention Based News Recommendation with Document Classification}, 
  year={2020},
  volume={},
  number={},
  pages={181-186},
  abstract={Online news services have become the first choice to read news for many internet users. However, thousands of news articles are released and updated on a daily basis, which makes it impossible for users to select relevant and intriguing stories by themselves. The news recommendation models are developed to tackle information overload. News stories on various topics are recommended to users from diversified backgrounds by an automated system. In this paper, we propose a neural news recommendation model with self-attention jointly trained by document classification, SARC. The self-attention mechanism captures the long-term relationships among words. The joint training of recommendation and classification improves representation and generalization capability. We demonstrate our model’s superior performances over other state-of-the-art baselines on a large-scale news recommendation dataset.},
  keywords={Training;Additives;Machine learning;Cybernetics;Multi-task learning;Recommendation system;Text classification;Attention mechanism},
  doi={10.1109/ICMLC51923.2020.9469577},
  ISSN={2160-1348},
  month={Dec},}@INPROCEEDINGS{9671467,
  author={Raza, Shaina and Ding, Chen},
  booktitle={2021 IEEE International Conference on Big Data (Big Data)}, 
  title={Deep Neural Network to Tradeoff between Accuracy and Diversity in a News Recommender System}, 
  year={2021},
  volume={},
  number={},
  pages={5246-5256},
  abstract={The news recommender systems are marked by a few unique challenges specific to the news domain. These challenges emerge from rapidly evolving readers’ interests over dynamically generated news items that continuously change over time. News reading is driven by a blend of a reader’s long-term and short-term interests. In addition, diversity is required in a news recommender system to keep the reader engaged in the reading process and get them exposed to different views and opinions. This paper proposes a deep neural network that jointly learns news and user representation in a unified framework. It learns the news representation (features) from the headlines, snippets (body) and taxonomy (category, subcategory) of news. The attention mechanism learns a reader’s long-term interests from the complete click history, short-term interests from recent clicks via LSTMs and diverse interests. We also apply different levels of attention to our model. We conduct extensive experiments on two news datasets to demonstrate the effectiveness of our approach.},
  keywords={Deep learning;Performance evaluation;Soft sensors;Neural networks;Taxonomy;Big Data;Data models;Recommender System;Deep Neural Network;Attention;Diversity;Accuracy},
  doi={10.1109/BigData52589.2021.9671467},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9679845,
  author={Raza, Shaina and Bashir, Syed Raza and Liu, Dora D. and Naseem, Usman},
  booktitle={2021 International Conference on Data Mining Workshops (ICDMW)}, 
  title={Balanced News Neural Network for a News Recommender System}, 
  year={2021},
  volume={},
  number={},
  pages={65-74},
  abstract={News recommender systems face unique challenges due to the rapidly changing readers&#x2019; interests over time. Some of the reader&#x2019;s interests are long-term, and some are short-term that need to be addressed in a news recommender system. Diversification is also required in a news recommender system to keep readers engaged in the reading process and expose them to various viewpoints. We propose a deep neural network for the news recommendation problem that learns multi-faceted news representations from the news content. The proposed model also learns the reader&#x2019;s long-term interests from the whole click history and the short-term ones from the click history using LSTMs. The attention mechanism is used to learn a reader&#x2019;s diversified interests. We give different levels of attention to the news and reader components. Experiments on two news datasets have shown the superiority of our proposed method compared to state-of-the-art methods.},
  keywords={Deep learning;Conferences;Neural networks;Data models;History;Data mining;Recommender systems;Recommender System;Deep Neural Network;Attention;Diversity;Accuracy},
  doi={10.1109/ICDMW53433.2021.00015},
  ISSN={2375-9259},
  month={Dec},}@INPROCEEDINGS{9933189,
  author={Fan, Linjuan and Xu, Fei and Sun, Yongyong and Zhou, Hanghang},
  booktitle={2022 International Conference on Computer Network, Electronic and Automation (ICCNEA)}, 
  title={News Recommendation Algorithm Based on Multiple Perspectives}, 
  year={2022},
  volume={},
  number={},
  pages={21-25},
  abstract={Today, with the rapid development of the Internet, the channels for people to obtain news are more and more diversified, and the number of online news is also increasing rapidly. However, it is more and more difficult for users to find the news that they are interested in. Therefore, personalized news the recommendation system is of great significance. In view of the fact that the current news recommendation system fails to fully consider the semantic information of news and the singleness of the modeling factors of news text, it cannot fully consider the semantic information of news and cannot accurately vectorize the information of news content, we propose News Recommendation Algorithm Based on Multiple Perspectives (BTEC). The model using the Bert model and attention to vectorize the body, title, event in the news respectively, and the dense layer is used to vectorize the news categories. then according to this four perspective are fused to process the candidate news and user browsing news data, respectively to obtain the corresponding candidate news vectorization and user vectorization, and dot multiplication them to obtain the probability of users clicking on the candidate news. that is, the news recommendation result. Experimental data show that BTEC improves the F1 index by about 8% compared with the other news recommendation algorithm.},
  keywords={Automation;Semantics;Neural networks;Internet;Indexes;Recommender systems;News Recommendation System;Multiple Perspective;Attention Mechanism;Event;Vectorization},
  doi={10.1109/ICCNEA57056.2022.00016},
  ISSN={2770-7695},
  month={Sep.},}@INPROCEEDINGS{10032442,
  author={Raza, Shaina and Bashir, Syed Raza and Naseem, Usman and Liu, Dora D. and Reji, Deepak John},
  booktitle={2022 IEEE 9th International Conference on Data Science and Advanced Analytics (DSAA)}, 
  title={Incorporating Accuracy and Diversity in a News Recommender System}, 
  year={2022},
  volume={},
  number={},
  pages={1-10},
  abstract={There are certain challenges in news recommender systems that arise due to changing users’ preferences over dynamically generated news articles. It is important to expose users to a variety of information. Diversity is required in a news recommender system not only so that users do not get bored of reading similar news but because so that they do not get trapped in information bubbles. We propose a deep neural network based on a two-tower architecture that learns news representation through a news item tower and users’ representations through a query tower. To learn diversity, we introduce a category loss function that aligns items’ representation of uneven news categories. Experimental results on two news datasets reveal that our proposed architecture is more effective compared to the state-of-the-art methods and achieves a balance between accuracy and diversity.},
  keywords={Measurement;Deep learning;Poles and towers;Neural networks;Data science;Recommender systems;News recommender system;recommendations;accuracy;relevancy;diversity;trade-off},
  doi={10.1109/DSAA54385.2022.10032442},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10541576,
  author={Saxena, Ankur},
  booktitle={2023 5th International Conference on Advances in Computing, Communication Control and Networking (ICAC3N)}, 
  title={A Survey of Session-Based Recommender Systems}, 
  year={2023},
  volume={},
  number={},
  pages={47-50},
  abstract={Session-based recommender systems have gained significant attention in recent years due to their ability to capture user preferences and provide personalized recommendations based on sequential interactions. These systems consider user sessions as a unit of analysis, taking into account the temporal dynamics and context of user behavior. This paper presents an overview of session-based recommender systems, discussing their key components and methodologies. The focus is on capturing the short-term interests and preferences of users by analyzing their recent session history. Various approaches, including collaborative filtering, recurrent neural networks, and hybrid models, are explored to model the session-context and make accurate recommendations. Additionally, the paper examines the challenges and opportunities associated with session-based recommender systems. These challenges include data sparsity, cold start problem, session representation, and scalability. Solutions and techniques to address these challenges are discussed, such as session encoding methods, session-based evaluation metrics, and data augmentation techniques. The evaluation of session-based recommender systems is also addressed, highlighting the metrics used to assess the effectiveness of recommendations, including precision, recall, and diversity. Furthermore, real-world applications and case studies of session-based recommender systems across various domains, such as e-commerce, online streaming, and news recommendation, are presented to showcase their practicality and impact. An experiment is also conducted to do a comparative analyses of many well-known techniques that are in use for making recommendations in sessions.},
  keywords={Measurement;Surveys;Recurrent neural networks;Scalability;Collaborative filtering;Data augmentation;Encoding;Session Baes Recommendation System;Graphical Neural Networks},
  doi={10.1109/ICAC3N60023.2023.10541576},
  ISSN={},
  month={Dec},}@ARTICLE{10440344,
  author={Sonoda, Atom and Toriumi, Fujio and Nakajima, Hiroto},
  journal={IEEE Access}, 
  title={User Experiments on the Effect of the Diversity of Consumption on News Services}, 
  year={2024},
  volume={12},
  number={},
  pages={31841-31852},
  abstract={On many online platforms, more items are being added every day, requiring users to select efficiently the desired item from among these candidates. In similar environments, recommender systems have been introduced, allowing users to select from among recommended items. While the immediate advantages of recommender systems, such as presenting users with pertinent information efficiently and boosting page views, are well recognized, concerns have been raised that these systems might constrict users’ choices and amplify echo chambers. Despite these concerns, the detrimental impacts of recommender systems on user behavior have not been thoroughly investigated. To address the societal challenges stemming from the limitation in the breadth of information to which users are exposed, a novel recommender system offering a wider array of choices is essential. In this study, we examine the user experience of the Nikkei Electronic Version, a major news delivery service in Japan, from the perspective of diversity. Using the language of article titles, we evaluate the diversity of recommended results and click logs presented to users. In addition to an analysis of the actual service, we conduct user experiments with participants recruited from among users of the service to investigate the effect of recommendation algorithms specialized in increasing diversity, separate from the actual service. We propose a recommender system based on the concept of extracting articles as far apart as possible within the language space. Through static experiments and user experiments, we show that the proposed recommender system is effective in diversifying the recommendation list. Furthermore, we show that when candidate articles that are likely to be clicked can be properly extracted, the proposed recommender system is effective in diversifying the articles that users click. Our research is aimed at improving long-term satisfaction by recommending content that users can enjoy in the short term while simultaneously ensuring diversity.},
  keywords={Recommender systems;Vectors;Behavioral sciences;Measurement;User experience;Media;Online services;Diversity methods;User experience;Electronic publishing;Diversity;user engagement;online news;recommender systems},
  doi={10.1109/ACCESS.2024.3367770},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{10627111,
  author={Sharma, Rhea and Sharma, Ishaan and Kumar, Siddharth and H, Shrinivas and Bhardwaj, Aditi},
  booktitle={2024 4th International Conference on Intelligent Technologies (CONIT)}, 
  title={User-driven Relevant News Update System (U.R.A.N.U.S)}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={In an era characterized by information overload,the need for effective news recommendation systems has become paramount. This review paper provides a comprehensive ex-amination of the methodologies, challenges, and advancements in the domain of news recommendation systems. It explores two primary technologies commonly employed in recommender systems: information filtering and collaborative filtering, elu- cidating their respective features, advantages, and limitations. The paper delves into the application of these technologies in personalized news reading applications, such as PIN, WebClip- ping2, and GroupLens, highlighting their unique approaches to user modeling and recommendation generation. Additionally, it discusses the integration of hybrid methods, which combine information filtering and collaborative filtering techniques, to enhance recommendation quality. The review also addresses key issues in user modeling, including the dynamic nature of user interests and the incorporation of temporal aspects in profile construction. Ethical considerations, such as fairness, diversity, and privacy, are examined in the context of news recommendationsystem design. Through a thorough analysis of performance metrics and comparative studies against baseline models, the paper evaluates the efficacy of various news recommendation approaches. Finally, it identifies future research directions and potential areas for innovation in the field, paving the way forthe development of more sophisticated and user-centric newsrecommendation systems.},
  keywords={Ethics;Technological innovation;Privacy;Reviews;Heuristic algorithms;Collaborative filtering;Information filters;information filtering;collaborative filtering;rec-ommendation systems},
  doi={10.1109/CONIT61985.2024.10627111},
  ISSN={},
  month={June},}@INPROCEEDINGS{10825032,
  author={Colin, Jonathan and Maniu, Silviu},
  booktitle={2024 IEEE International Conference on Big Data (BigData)}, 
  title={Optimizing Diverse Information Exposure in Social Graphs}, 
  year={2024},
  volume={},
  number={},
  pages={519-528},
  abstract={The popularity of online social networks and the social interactions they allow has brought great benefits in terms of ease of communication, allowing them to hold a major role in the dissemination and consumption of information. Users of media can be exposed to a wide range of opinions, either actively or passively. Recommendation systems have been developed to steer users towards like-minded content, to the detriment of new, niche, or diverse content. This can lead to fake news, filter bubbles, and opinion polarization.In this paper, we introduce a framework to achieve better diversity in social networks, by formulating information exposure diversity as an optimization problem in which local modifications on the graph, via edge additions, have the objective of maximizing a target diversity metric from the point of view of an user in the network. We formalize the notion of information exposure linking it to well-studied models in the literature, and provide several algorithms for solving this problem, by leveraging gradient descent-based approaches and greedy algorithms. We show experimentally that our algorithms achieve better diversity measures than state-of-the-art algorithms, on a varied set of real-world graphs.},
  keywords={Measurement;Greedy algorithms;Social networking (online);Big Data;Information filters;Cultural differences;Data mining;Fake news;Recommender systems;Optimization;graph optimization;diversity and polarization;social networks;graph data mining},
  doi={10.1109/BigData62323.2024.10825032},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{10825982,
  author={Karimi, Mozhgan and Feremans, Len and Cule, Boris and Goethals, Bart},
  booktitle={2024 IEEE International Conference on Big Data (BigData)}, 
  title={Session-based News Recommendation Using Cohesive Patterns}, 
  year={2024},
  volume={},
  number={},
  pages={440-447},
  abstract={In the rapidly evolving field of news recommendation, where user preferences are highly dynamic and content quickly becomes obsolete, providing timely and relevant recommendations presents a significant challenge. Traditional recommender systems typically rely on complex collaborative filtering models that depend on extensive user histories. In the news domain, however, such histories are often scarce due to the high prevalence of anonymous users. To address these challenges, we introduce a novel session-based recommendation method that leverages cohesive sequential pattern mining. Rather than relying on traditional frequency-based pattern utility metrics, our approach prioritizes pattern cohesiveness, which captures the temporal proximity of item interactions within a pattern, resulting in recommendations that align more closely with the user’s ongoing session.We conduct a comprehensive empirical evaluation of our approach using four large-scale real-world news datasets. The results demonstrate that our method, SeQcsp, significantly outperforms state-of-the-art session-based recommendation algorithms in terms of accuracy, ranking quality, as well as diversity. Furthermore, SeQcsp provides recommendations faster than most existing methods and is effective for both short and long user sessions, highlighting its robustness, adaptability, and efficiency.},
  keywords={Measurement;Accuracy;Collaborative filtering;Big Data;Robustness;History;Recommender systems;large-scale recommendation systems;session-based news recommendation;pattern mining;pattern cohesion},
  doi={10.1109/BigData62323.2024.10825982},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{10831172,
  author={He, Jiaxing and Li, Liang and Mao, Xingbin},
  booktitle={2024 IEEE International Conference on Systems, Man, and Cybernetics (SMC)}, 
  title={News Session Recommendation Based on Long and Short-Term User Interest Representation and Multi-View Learning}, 
  year={2024},
  volume={},
  number={},
  pages={4011-4016},
  abstract={In the current context of proliferation of news information, personalised news recommendation is important to help users quickly access content of interest. Existing approaches tend to ignore the diversity of users' reading behaviours and the variability of news topics within a session. They tend to assume that all the news read or clicked within a session are attributed to one main interest, while in reality, each news session may cover a variety of news with different interests corresponding to different topics. The paper introduces a news session recommendation approach that utilizes both long-and short-term representations of user interests, incorporating multi-view learning techniques, and the method treats the clicking behaviours of anonymous users as a session: initially, a multi-scale convolutional neural network is employed to capture the features of user-clicked news articles from mul-tiple viewpoints; Subsequently, a GRU multi-channel interest decoupler is crafted to identify potential interests within each clicked news item, enabling the modeling of diverse interests to capture the user's long-term preferences. Concurrently, recent user-clicked news items are considered as short-term interests. These long and short-term interests are then amalgamated to create the ultimate user interest representation; Finally, the user's preference value for the candidate news is calculated by click-summing and the final recommendation result is generated. By comparing with the benchmark method on the real data set, the findings demonstrate strong performance on objective evaluation metrics such as Area Under the ROC Curve (AUC) and Normalised Discounted Cumulative Gain (NDCG), affirming the efficacy of the proposed method for news recommendation.},
  keywords={Measurement;Accuracy;Fuses;Merging;Benchmark testing;Data models;User preference;Convolutional neural networks;Cybernetics;Context modeling},
  doi={10.1109/SMC54092.2024.10831172},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10899545,
  author={Qiu, Danping},
  booktitle={2024 2nd International Conference on Artificial Intelligence and Automation Control (AIAC)}, 
  title={Research on News Recommendation Algorithm Based on Deep Learning}, 
  year={2024},
  volume={},
  number={},
  pages={522-525},
  abstract={With the rapid development of Internet technology, the problem of news information overload is becoming increasingly serious. How to efficiently filter out the news that users are interested in has become a current research hotspot. This article mainly discusses the news recommendation algorithm based on deep learning, and constructs an efficient recommendation model by analyzing user behavior data and news content. Research has found that deep learning techniques can significantly improve the accuracy of news recommendations and user satisfaction. This article provides a detailed introduction to the development history of news recommendation systems, the limitations of traditional recommendation algorithms, and the advantages of applying deep learning in news recommendation. In addition, this article also compares and analyzes various deep learning based news recommendation algorithms, and looks forward to future research directions.},
  keywords={Deep learning;Analytical models;Automation;Filtering algorithms;Information filters;Data models;Internet;History;Artificial intelligence;Recommender systems;deep learning;News recommendation system;User modeling;Content modeling;Collaborative filtering;evaluating indicator},
  doi={10.1109/AIAC63745.2024.10899545},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11168644,
  author={Liu, Xu},
  booktitle={2025 3rd International Conference on Data Science and Network Security (ICDSNS)}, 
  title={A Hierarchical Contextual Graph-Transformer Network for Multi-Objective Personalized News Recommendation}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Personalized news recommendation has become the key to tackle the plethora of digital content, providing timely and relevant information to users. Conventional systems like collaborative filtering and simple content-based filtering tend to be limited by issues like cold-start problems, absence of rich semantic knowledge, and inability to track dynamic user preferences. Current deep learning-based models, which are good at extracting rich representations, often specialize in either sequential behavior or relational structure but do not fully combine the two to support better personalization. Addressing such limitations, this study introduces a Hierarchical Contextual Graph-Transformer Network (HCGTN) that interweaves domain-adapted BERT for semantic news content representation, Graph Neural Networks for capturing intricate user-item-entity relations, and Transformer layers for capturing user interaction sequences over time. A new multiobjective ranking loss concurrently optimizes accuracy, diversity, and long-term engagement, while a semantic similarity-based cold-start approach enhances recommendations for new users and pieces. Experimental benchmarking on standard news recommendation datasets proves that HCGTN surpasses current baselines, such as deep neural and graph-based methods, in CTR prediction, diversity, and coverage. The suggested method provides an effective and scalable system for future-generation personalization in news delivery, tuning relevance to content variety to enhance user satisfaction and retention.},
  keywords={Deep learning;Filtering;Semantics;Network security;Data science;Transformers;Graph neural networks;Data models;Tuning;Standards;personalized news recommendation;deep learning networks;graph neural networks (GNN);transformer models;cold-start problem},
  doi={10.1109/ICDSNS65743.2025.11168644},
  ISSN={},
  month={July},}@INPROCEEDINGS{11189751,
  author={Mui, Theodore and Mui, Phil},
  booktitle={2025 International Conference on Artificial Intelligence and Digital Ethics (ICAIDE)}, 
  title={Why are we Cynical? A Semantic Analysis of College Newspaper Opinions}, 
  year={2025},
  volume={},
  number={},
  pages={494-501},
  abstract={Cynicism, a distrust of people and institutions, creates serious obstacles for building social unity and working together effectively. 3, 14 In this paper, we study how signs of cynicism have been growing in the opinions section of the Stanford Daily and the Harvard Crimson - two of the most respected US colleges. While this study focuses specifically on these two elite institutions, providing an in-depth analysis within their unique contexts from 2010 to 2024, our analysis shows that their students have been writing about a narrower set of topics over time, resulting in a shrinking space of ideas in the opinion sections of both elite colleges’ student newspapers. We then use semantic, sentiment, and lexical analysis to understand how cynical rhetoric has evolved. While our hypothesis focuses on the divergence between the rising rhetoric of diversity and the shrinking space of ideas leading to cynical attitudes toward diversity programs, we acknowledge potential alternative explanations. These include broader societal shifts in political polarization and declining trust in institutions, as well as changes in media consumption habits, such as increased reliance on social media and personalized news feeds, which could contribute to echo chambers and narrowed discourse. Understanding these dynamics within the college context, while also recognizing its relevance to broader trends, is crucial for fostering a more open and trusting academic environment. Through surfacing quantitative observational studies, we hope our findings can help find ways to encourage more inclusive conversations and make Stanford and Harvard a more welcoming place for all opinions and potentially inform future studies on a wider range of institutions.},
  keywords={Training;Ethics;Social networking (online);Semantics;Oral communication;Media;Writing;Market research;Rhetoric;Cultural differences;Semantic analysis;lexical analysis;cynicism;diversity;embedding analysis;space of ideas;moral foundation theory;MFT},
  doi={10.1109/ICAIDE65466.2025.11189751},
  ISSN={},
  month={May},}@INPROCEEDINGS{11198046,
  author={Chen, Tingting and Liu, Lei and Yan, Shuying and Si, Jinxin and Sun, Fuyong},
  booktitle={2025 21st International Conference on Natural Computation, Fuzzy Systems and Knowledge Discovery (ICNC-FSKD)}, 
  title={PHNR: Popularity-Aware and Hierarchical News Recommendation}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Recommendation system is one of the key technologies to solve the problem of information overload. Aiming at the balance between diversity and accuracy in personalized news recommendation, the Popularity-aware and Hierarchical News Recommendation is proposed based on dual-encoder learning framework and attention mechanism, named PHNR. This paper integrates popularity to generate news representation and predict popularity scores. And then we design a hierarchical user modeling framework to generate different user representations from categories, subcategories and news content, respectively, to achieve hierarchical and refined capture of user interests. We improve the click predictor as well, get weighted aggregation of multi-level interest scores and popularity scores, and finally obtain the probability score of users clicking on candidate news. This model can improve the diversity of the results while ensuring accuracy. Multiple experiments conducted on the public dataset MIND have proved the effectiveness of the PHNR.},
  keywords={Attention mechanisms;Accuracy;Computational modeling;Knowledge discovery;Recommender systems;Fuzzy systems;Personalized news recommendation;Attention mechanism;Diversity;News popularity;Hierarchical matching},
  doi={10.1109/ICNC-FSKD67701.2025.11198046},
  ISSN={},
  month={July},}@INPROCEEDINGS{11280604,
  author={Kalita, Dhanjit and Pradhan, Tribikram},
  booktitle={2025 5th Asian Conference on Innovation in Technology (ASIANCON)}, 
  title={SEHRS: Sentiment-Enhanced Hybrid Recommender System for Personalized News Recommendation}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Personalized news recommendation faces unique challenges including dynamic user preferences, content diversity requirements and the cold start problem. This paper presents SEHRS (Sentiment-Enhanced Hybrid Recommender System) a novel approach that integrates knowledge-aware features (KRED), Deep-Attention Neural Network (DAN) and sentiment analysis for enhanced news recommendation. We evaluate SEHRS against content-based filtering, collaborative filtering, KRED and DAN baselines on a custom MIND-like dataset using 12 comprehensive evaluation metrics. Our experimental results demonstrate that SEHRS achieves superior performance across 8 out of 12 metrics, particularly excelling in Average Precision (0.5155), Mean Reciprocal Rank (0.6014), NDCG@5 (0.4334), and Diversity (0.8000). The hybrid approach effectively combines the strengths of knowledge-aware recommendations, attention-based feature weighting, and sentiment analysis to provide balanced performance across ranking quality, diversity and coverage metrics.},
  keywords={Measurement;Sentiment analysis;Technological innovation;Filtering;Neural networks;Knowledge graphs;Media;Journalism;Real-time systems;Recommender systems;News Recommendation;Hybrid Recommender Systems;Sentiment Analysis;Knowledge Graphs;Attention Mechanisms;MIND Dataset},
  doi={10.1109/ASIANCON66527.2025.11280604},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11309028,
  author={Liu, Feng and Wei, Pei and Li, Shuyuan and Xu, Zifeng},
  booktitle={2025 6th International Conference on Computer Engineering and Intelligent Control (ICCEIC)}, 
  title={Research on News Recommendation Model Based on Knowledge Enhancement and Diversity Perception--Oriented to Information Cocoon Effect Solutions}, 
  year={2025},
  volume={},
  number={},
  pages={278-281},
  abstract={Aiming at the common problems of “information cocoon room” effect, algorithm bias and technical limitations in news recommendation systems, we propose a new recommendation model USPRMICE, which combines knowledge enhancement and diversity perception. The model realizes knowledge transfer across feature domains by constructing cross-compression units, uses mean shift clustering to quantify user interest diversity, and innovatively introduces mixed utility function to dynamically balance recommendation accuracy and diversity. Experiments on the MIND dataset show that USPRMICE outperforms the baseline algorithm in key recommendation metrics. In particular, the model effectively alleviates the problem of homogenization of recommended content through the diversity perception module, reduces the variance of prediction scores of different topics of news, and also reduces the polarization index of views. we provide an innovative solution for building an intelligent, fair and diverse news recommendation system, which not only improves the quality of personalized services, but also effectively promotes the diverse development of information ecology.},
  keywords={Accuracy;Biological system modeling;Computational modeling;Scalability;Clustering algorithms;Data models;Robustness;Real-time systems;Recommender systems;Context modeling;Recommender algorithm;Matrix factorization;Diversity regularization},
  doi={10.1109/ICCEIC67916.2025.11309028},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11318308,
  author={Khanna, Abhirup and Negi, Dakshita and Sah, Anushree and Rawat, Saurabh and Maheshwari, Piyush},
  booktitle={2025 International Conference on Computational Intelligence and Knowledge Economy (ICCIKE)}, 
  title={Autonomous AI Agents for Personalized News Curation Without Bias Reinforcement}, 
  year={2025},
  volume={},
  number={},
  pages={524-529},
  abstract={The accelerated growth of digital content demands the guaranteed information delivery on the basis of individualism and accountability in the news recommendation systems. One of the contributions of the paper is a proposal of an independent, AI-based system that would allow curating a personalized newsstream, thereby reducing the strengthening of bias and enhancing diversity, as well as user engagement. The framework consists of Sentence-BERT (SBERT) to achieve better semantic understanding, Determinantal Point Processes (DPP) to select diversities, and a Deep Q-Network (DQN) to control the decision-making behavior of reinforcement. SBERT embeddings facilitate a finer content/user profile fit by finding out the contextual nuances that go beyond keyword matching. The informed reordering by DPP adds not only topical but also ideological variety, so that redundancy is lessened and filter bubbles are counteracted. The DQN agent learns independently on how to balance user satisfaction with fairness with a longterm reward policy that punishes bias reinforcement. Empirical findings prove that the implemented framework provides better personalization accuracy, intra-list similarity decrease, and steady policy convergence compared to traditional ranking models. The system provides a base to ethical, adaptive, and scalable artificial intelligence agents in news personalization through the amalgamation of semantic modeling, probabilistic diversity, and reinforcement learning. The study will help in advancing viable and transparent recommender systems, which will be able to create knowledgeable consumption as well as democratic media values.},
  keywords={Ethics;Adaptation models;Biological system modeling;Semantics;Redundancy;Media;Artificial intelligence;Recommender systems;Convergence;Testing;Autonomous AI Agents;Media Diversity;Personalized News;AI in Journalism},
  doi={10.1109/ICCIKE67021.2025.11318308},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11342199,
  author={Tang, Xu},
  booktitle={2025 2nd International Conference on Software, Systems and Information Technology (SSITCON)}, 
  title={Personalized News Recommendation System Using Hybrid Collaborative Filtering and Latent Factor Modeling}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={Nowadays, the personalized news recommendation has become crucial in managing the overwhelming volume of online content for ensuring that the users receive relevant and engaging information. However, the existing models faced challenges which led to limit scalability, inability to capture temporal dynamics and poor recommendation diversity. Hence, this research proposes a Hybrid Collaborative Filtering and Latent Factor Modeling (HCF-LFM) model to provide accurate, scalable and interpretable personalized news recommendations. Initially, the input data is collected from Microsoft New Dataset (MIND) which contains over 1M users, 160k new articles and 24M user interactions for providing a robust basis for modeling user preferences and article relevance. Then, the collected data is preprocessed to construct a user-item interaction matrix, handle sparsity, and encode article metadata. After that, the features are extracted through user and item similarity computations, latent factor decomposition and article embeddings by capturing the semantic content. Finally, the recommendation system combines collaborative filtering techniques and matrix factorization predictions to generate tope-K personalized news for each user. From the results, the proposed HCF-LFM demonstrated improved precision, recall and ranking metrics than the existing models.},
  keywords={Adaptation models;Accuracy;Computational modeling;Collaborative filtering;Scalability;Semantics;Metadata;Feature extraction;Matrix decomposition;Recommender systems;content-enhanced embeddings;collaborative filtering;latent factor modeling;matrix factorization;personalized news recommendation system},
  doi={10.1109/SSITCON66133.2025.11342199},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11400919,
  author={Alshehri, Manal A. and Zhang, Xiangliang},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={Unveiling the Dynamics of Multi-Dimensional Filter Bubbles in News Recommendation}, 
  year={2025},
  volume={},
  number={},
  pages={418-425},
  abstract={News recommendation systems aim to personalize content by aligning it with user preferences. However, this personalization often leads to the formation of filter bubbles that reinforce existing biases and limit exposure to diverse perspectives. While existing studies have primarily focused on a single dimension of bias, this paper investigates the dynamics of filter bubbles across multiple dimensions, including news topic, sentiment, and political leaning. Real-world news often blends these dimensions, and focusing on only one risks missing critical patterns in how personalization shapes user exposure. Our findings reveal a complex interplay: a decline in diversity along one dimension (e.g., topic) often intensifies biases in others (e.g., sentiment or political leaning), reinforcing multi-dimensional filter bubbles and further narrowing exposure. Moreover, advanced contextual understanding in modern news recommendation models accelerates this compounding effect, amplifying filter bubble formation across all dimensions over time. These results underscore the importance of analyzing these dimensions jointly and highlight the challenge of balancing personalization with content diversity. Additionally, we contribute a valuable resource for future research, including a dataset of annotated news articles and a simulated news recommendation environment to study the formation and evolution of filter bubbles. Both are available at https://github.com/annresearch/NRSim.},
  keywords={Shape;Focusing;Big Data;Recommender systems;Context modeling;News Recommendation;Filter bubbles;MultiDimensional Bias},
  doi={10.1109/BigData66926.2025.11400919},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11401601,
  author={Earl, Eamon and Ding, Chen and Valenzano, Richard and Paulen-Patterson, Drai},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={Constructing Political Coordinates: Aggregating Over the Opposition for Diverse News Recommendation}, 
  year={2025},
  volume={},
  number={},
  pages={1695-1704},
  abstract={In the past two decades, open access to news and information has increased rapidly, empowering educated political growth within democratic societies. News recommender systems (NRSs) have shown to be useful in this process, minimizing political disengagement and information overload by providing individuals with articles on topics that matter to them. Unfortunately, NRSs often conflate underlying user interest with the partisan bias of the articles in their reading history and with the most popular biases present in the coverage of their favored topics. Over extended interaction, this can result in the formation of filter bubbles and the polarization of user partisanship. In this paper, we propose a novel embedding space called Constructed Political Coordinates (CPC), which models the political partisanship of users over a given topic-space, relative to a larger sample population. We apply a simple collaborative filtering (CF) framework using CPC-based correlation to recommend articles sourced from oppositional users, who have different biases from the user in question. We compare against classical CF methods and find that CPC-based methods promote pointed bias diversity and better match the true political tolerance of users, while classical methods implicitly exploit biases to maximize interaction.},
  keywords={Correlation;Open Access;Computational modeling;Collaborative filtering;Computer architecture;Big Data;Data models;Entropy;History;Recommender systems;news recommendation;filter bubbles;unbiased recommendation;blind-spot detection;recommendation diversity;user behavior modeling;bias modeling;computational politics},
  doi={10.1109/BigData66926.2025.11401601},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11446859,
  author={Anand, Rohit and Srinivasan, V. and Jayanthi, R. and Baranwal, Sajal and R, Ramya and Rakesh},
  booktitle={2025 International Conference on Transformative Computing Technologies (ICTCT)}, 
  title={Optimizing News Recommendation Systems: A Hybrid Approach to Personalized Content Delivery}, 
  year={2025},
  volume={},
  number={},
  pages={123-129},
  abstract={Recommendation systems are now essential for helping users sort through the vast amount of digital information. News recommendation is particularly challenging because articles are continuously produced and quickly become outdated. Traditional methods like K-Means clustering, content-based filtering, and bandit algorithms such as Thompson Sampling [2] and Upper Confidence Bound (UCB) [2] are effective but struggle to find the right balance between personalization and exploring new content. In this research, we introduce a hybrid solution that combines UCB and Thompson Sampling to achieve a better balance. Using the Microsoft News Dataset (MIND), our experiments show that the hybrid model outperforms the individual methods in terms of accuracy, diversity, and user engagement. To strengthen our findings, we include statistical significance testing, confidence interval analysis, and robustness checks to confirm that the improvements are both significant and meaningful. We also place our research within the context of recent developments in 2024–2025 related to transformer-based and fairness-aware recommender systems. Overall, these contributions indicate that our hybrid model not only performs well but also consistently provides personalized and engaging news recommendations.},
  keywords={Computers;Accuracy;Filtering;Computational modeling;Clustering algorithms;Transformers;Robustness;Recommender systems;Testing;Digital information;News recommendation;content-based filtering;K-means clustering;multi-armed bandit;upper confidence bound (UCB);Thompson sampling;hybrid recommendation system;exploration-exploitation trade-off},
  doi={10.1109/ICTCT69201.2025.00037},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11500807,
  author={A, Devisree. and Juliet, A. Hency},
  booktitle={2025 3rd International Conference on Sustainable Computing and Smart Systems (ICSCSS)}, 
  title={Pareto-Constrained Deep Q-Learning for Multi-Objective News Recommendation with Ranking Optimization and Deep Engagement Modeling}, 
  year={2025},
  volume={},
  number={},
  pages={1814-1819},
  abstract={Delivering personalized news content is essential for improving user interaction and satisfaction on digital media platforms. Balancing multiple, often conflicting, objectives such as click-through rate (CTR), dwell time, and content diversity presents a complex reward design challenge, further compounded by the sparsity and noise of implicit user feedback, which hinders precise modeling of user preferences in news recommendation tasks. To address the challenges of balancing multiple conflicting objectives and dealing with sparse user feedback, this study presents a Pareto-Constrained Deep Q-Learning framework for multi-objective news recommendation, which balances goals like CTR, diversity, and dwell time using ranking-based optimization and a deep learning dwell time predictor to improve personalization and user engagement. The proposed system achieves notable improvements over baselines like NAML, NRMS, and DAN, with a CTR of 0.099, Precision@K of 0.0984, nDCG@K of 0.3916, minimal training loss, and 99.5% constraint satisfaction. Thus, this study presents a Pareto-Constrained Deep Q-Learning framework for multi-objective news recommendation, which balances goals like CTR, diversity, and dwell time using ranking-based optimization and a deep learning dwell time predictor to improve personalization and user engagement.},
  keywords={Radio broadcasting;Frequency modulation;Feedback;Recommender systems;Filtering;Circuits;Filters;Information filtering;Collaborative filtering;Filtering theory;Deep Reinforcement Learning;Multi-Objective Optimization;News Recommendation Systems;Pareto-Constrained Learning;User Engagement Prediction;Dwell Time Modeling;Ranking Metrics Evaluation;Neural Networkbased Recommender Systems},
  doi={10.1109/ICSCSS64956.2025.11500807},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11451856,
  author={Escorial, Ryan B. and Diamano, Niño Franquine B.},
  booktitle={2026 5th International Conference on Sentiment Analysis and Deep Learning (ICSADL)}, 
  title={The Role of Recommender Systems in Everyday Life}, 
  year={2026},
  volume={},
  number={},
  pages={403-410},
  abstract={Recommender systems have become an important part of modern digital platforms, and shape how people consume content, shop items online, interact on social media platforms, and view different kinds of information online. The goal of such systems is to enhance user experience by analyzing user behavior and preferences to generate personalized recommendations. This paper examines the role of recommender systems in everyday life and discusses their underlying mechanisms, real-world applications, and various societal implications. A review of related literature was conducted to identify commonly used approaches, specifically collaborative and content-based filtering, as well as hybrid approaches that combine two or more models. Moreover, a survey was conducted among students at Negros Oriental State University to identify their commonly used digital platforms and their activities on these platforms. The findings suggest that recommendation systems greatly influence user engagement, user behavior, and the content recommended, particularly across different social media and streaming platforms, e-commerce, delivery services, and other businesses that make use of recommender systems. Unfortunately, despite these advantages, there are several issues that were repeatedly mentioned in the related literature. Specifically, privacy and ethical concerns, irrelevant and similar recommendations, biases, and misinformation. Overall, this study highlights the importance of developing ethics- and user-centered, reliable, transparent, and adaptable recommender systems that balance user preferences with diversity. To ensure that these systems become more effective and efficient at producing recommendations in the future, understanding their benefits and limitations is as important as how these systems are developed.},
  keywords={Surveys;Ethics;Privacy;Video on demand;Social networking (online);Collaborative filtering;User experience;Web sites;Fake news;Recommender systems;recommender systems;recommendation systems;collaborative filtering;content-based filtering;hybrid system;user personalization},
  doi={10.1109/ICSADL67539.2026.11451856},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{11539494,
  author={A, Devisree and A, Hency Juliet and N, Legapriyadharshini},
  booktitle={2026 12th International Conference on Communication and Signal Processing (ICCSP)}, 
  title={LLM Enhanced Policy Gradient Approach for Cold Start and Diversity Aware News Recommendation}, 
  year={2026},
  volume={},
  number={},
  pages={178-183},
  abstract={Recommender systems utilize user interactions and item features to generate personalized content; however, they often encounter challenges such as sparse feedback, data sparsity issues, and a tendency toward popularity bias, which limits diversity. To overcome these issues, this paper introduces an LLM-enhanced policy gradient framework that combines transformer-based semantic feature augmentation with reinforcement learning for news recommendation. The proposed approach is novel in its unified integration of semantic enrichment and diversity-aware optimization within a policy gradient model, which effectively mitigates data sparsity issues while maintaining recommendation diversity. The model enhances news representations using LLM-derived features and incorporates a diversity-aware reward mechanism to balance accuracy and content variety. Experimental results on the MIND-Small dataset demonstrate strong performance, achieving nDCG@10 of 0.6095, Precision@10 of 0.2857, Recall@10 of 0.9196, AUC of 0.5418, and MRR of 0.5174. Furthermore, the model shows notable improvements in coldstart scenarios, highlighting its ability to manage sparse interaction data effectively. Overall, the proposed framework delivers accurate, diverse, and robust recommendations suitable for dynamic real-world news environments.},
  keywords={Modeling;Printing;Large language models;Learning (artificial intelligence);Equations;Ranking (statistics);Optimization;Reinforcement learning;Feedback;Conferences;LLM-augmented recommendation;Policy Gradient;Innovation;Diversity-aware recommendation;Content diversity;Data-Driven Systems},
  doi={10.1109/ICCSP68173.2026.11539494},
  ISSN={2836-1873},
  month={April},}@INPROCEEDINGS{11648386,
  author={Kalita, Dhanjit and Pradhan, Tribikram and Roy, Subham},
  booktitle={2026 IEEE Guwahati Subsection Conference (GCON)}, 
  title={DeepBalance: A Multi-Objective Framework for Mitigating Personalization Challenges in News Recommendation Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={News recommendation systems face critical challenges including over-personalization, filter bubbles, echo chambers and popularity bias. News recommenders today often fail to expose users to diverse content and over-personalization creates filter bubbles and echo chambers because popularity bias suppresses less mainstream or new topics. These problems have implications for user satisfaction as well as public discourse and democracy, therefore personalization needs a transformation. We propose DeepBalance, a novel multi-objective framework that addresses these challenges through: (1) a diversity-aware neural architecture with attention mechanisms, (2) a fairness-constrained optimization approach, (3) an adaptive re-ranking strategy that balances relevance with exploration and (4) a temporal decay mechanism for breaking echo chambers. Our experimental evaluation on real-world datasets demonstrates significant improvements in recommendation diversity (42% increase), fairness metrics (38% improvement), and user satisfaction while maintaining competitive accuracy. In addition, the proposed DeepBalance achieves a 35% reduction in filter bubble effects and 28% improvement in content coverage compared to state-of-the-art news recommendation systems.},
  keywords={Modeling;Printing;Optimization;Equations;Recommender systems;Conferences;Ranking (statistics);Tagging;Filters;Measurement;News Recommendation;Attention Mechanism;Diversity;Fairness;Filter Bubbles;Multi-Objective Optimization},
